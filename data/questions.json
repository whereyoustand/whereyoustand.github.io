   }
  ]
 },
 {
  "n": 20,
  "source_id": "24",
  "dimension": 10,
  "type": "s",
  "text": "「有组织的团体，比一盘散沙的个人更能保护自己。」你认为——",
  "options": [
   {
    "key": "A",
    "text": "同意。必须组织起来",
    "value": 0.5
   },
   {
    "key": "B",
    "text": "不同意。组织起来反而会被少数人控制",
    "value": -0.4
